# ==============================================================================
# MILESWEB / CPANEL REVERSE PROXY TO FASTAPI (UVICORN PORT 8000)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't proxy existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route through PHP proxy bridge to reach Uvicorn (FastAPI) on 127.0.0.1:8000
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
