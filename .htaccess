# ==============================================================================
# MILESWEB FASTAPI BACKEND REVERSE PROXY (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route all incoming requests to the index.php proxy bridge
    RewriteCond %{REQUEST_URI} !^/index\.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
