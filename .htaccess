# ==============================================================================
# MILESWEB FASTAPI BACKEND ROUTING (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent loop on index.php
    RewriteRule ^index\.php$ - [L]

    # Route all API requests directly to root /index.php
    RewriteRule ^(.*)$ /index.php [QSA,L]
</IfModule>
